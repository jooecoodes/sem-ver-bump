# svb uses the first provider key that is set, in this order.

# 1. OpenRouter (default model: deepseek/deepseek-chat-v3-0324:free)
OPENROUTER_API_KEY=

# 2. Google Gemini (default model: gemini-2.0-flash)
GEMINI_API_KEY=

# 3. Groq (default model: llama-3.3-70b-versatile)
GROQ_API_KEY=

# Optional: override the provider base URL. Intended for local mock testing.
# SVB_BASE_URL=http://127.0.0.1:8080/v1
